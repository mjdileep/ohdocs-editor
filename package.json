{
  "name": "@ohdocs/editor",
  "version": "1.10.4",
  "description": "The shared document editor and document format used by OhDocs and SafeFN.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./style.css": "./dist/editor.css",
    "./spelling-worker.js": "./dist/spelling-worker.js",
    "./src/*": "./src/*",
    "./format/*": "./format/*",
    "./styles/*": "./styles/*",
    "./scripts/*": "./scripts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "test": "node scripts/icons.mjs && node --test \"src/*.test.mjs\" \"format/*.test.mjs\"",
    "build": "npm run icons && node scripts/build.mjs",
    "prepack": "npm run build",
    "demo": "npm run build && node demo/serve.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-code-block-lowlight": "3.33.1",
    "@tiptap/extension-details": "3.33.1",
    "@tiptap/extension-highlight": "3.33.1",
    "@tiptap/extension-list": "3.33.1",
    "@tiptap/extension-mathematics": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/extensions": "3.33.1",
    "@tiptap/markdown": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@tiptap/suggestion": "3.33.1",
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "highlight.js": "11.11.2",
    "katex": "0.18.10",
    "lowlight": "3.3.0",
    "lucide-static": "0.577.0",
    "marked": "17.0.6",
    "nspell": "2.1.5"
  },
  "license": "MIT",
  "homepage": "https://ohdocs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjdileep/ohdocs-editor.git"
  },
  "files": [
    "dist",
    "format",
    "src",
    "styles",
    "scripts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "package-lock.json",
    "!src/*.test.mjs",
    "!format/*.test.mjs",
    "demo"
  ],
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "private": true
}
